# Public HTTPS origin used for canonical, social, robots.txt, and sitemap URLs.
# After the first Pages deployment, set this to the exact generated *.pages.dev origin.
PUBLIC_SITE_URL=

# Public HTTPS origin of the separate Node/WebSocket service, with no /ws suffix.
# This is public client configuration, not a secret. Leave blank for local same-origin /ws proxying.
PUBLIC_BACKEND_URL=
